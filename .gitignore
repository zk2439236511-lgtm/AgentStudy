# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# SQLite 运行时数据库（首次运行会自动重建）
*.db

# Chroma 持久化向量索引（本地生成，可由 ingest 重建）
apps/knowledge-rag/data/

# 第三方原始语料（体积大且可由 evals/datasets/*/MANIFEST.json 里的 URL + sha256 重新下载）
evals/datasets/raw/

# Node / 前端
node_modules/
dist/

# 运行期日志
*.log

# 环境变量与密钥（永远不进仓库）
.env
*.key

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本地临时备份
Study.local.md
Study.remote.md
